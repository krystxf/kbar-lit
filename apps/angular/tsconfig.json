{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": ["ES2022", "DOM"],
    "outDir": "dist/types"
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true }
}
