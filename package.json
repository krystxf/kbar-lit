{
  "name": "kbar-lit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "turbo run test",
    "test:browser": "pnpm exec playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:browser && pnpm test:examples",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:examples": "pnpm exec playwright test -c playwright.examples.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "kbar-lit": "workspace:*",
    "turbo": "^2.11.8"
  }
}
