{
  "name": "kbar-lit",
  "version": "0.1.0",
  "description": "An extensible command palette built with Lit and Web Components, inspired by kbar.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krystxf/kbar-lit.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "PARITY.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@tanstack/virtual-core": "^3.19.4",
    "fuse.js": "^7.5.0",
    "lit": "^3.3.3",
    "tinykeys": "^4.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
